generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoDado {
  FATO_OFICIAL
  FATO_PUBLICO
  INFERENCIA
  HIPOTESE
  DEMONSTRACAO
  DADO_TERCEIRO_NAO_CANONICO
}

enum NivelConfianca {
  ALTA
  MEDIA
  BAIXA
}

enum StatusRevisao {
  APROVADA
  PENDENTE
  REJEITADA
}

enum FaixaPrioridade {
  MUITO_ALTA
  ALTA
  MODERADA
  BAIXA
}

enum StatusLote {
  EM_PROCESSAMENTO
  CONCLUIDO
  CONCLUIDO_COM_ALERTAS
  FALHOU
}

enum StatusRegistroIngestao {
  ACEITO
  REJEITADO
  REVISAO_NECESSARIA
}

enum SegmentoComercial {
  NUCLEO_HOSPITALAR
  SAUDE_CORPORATIVA_EXPANDIDA
  BAIXA_PRIORIDADE_INICIAL
  FORA_DO_FOCO_ATUAL
}

enum FaixaAderencia {
  ALTA
  MEDIA
  BAIXA
  FORA_DO_FOCO
}

enum StatusRevisaoSegmentacao {
  NAO_REVISADO
  APROVADO
  AJUSTE_NECESSARIO
}

enum TipoVinculo {
  OFICIAL
  PROVAVEL
  ISOLADO
  INCERTO
}

enum NaturezaJuridicaClasse {
  PUBLICO
  PRIVADO
  INDETERMINADO
}

enum EscopoContato {
  ORGANIZACAO
  INSTITUICAO
}

model GrupoEconomico {
  id               String                   @id
  nome             String
  nomeNormalizado  String?
  tipoDado         TipoDado                 @default(DEMONSTRACAO)
  tipoVinculo      TipoVinculo              @default(ISOLADO)
  nivelConfianca   NivelConfianca           @default(BAIXA)
  tipoEvidencia    String?
  regraAgrupamento String?
  versaoRegra      String?
  statusRevisao    StatusRevisaoSegmentacao @default(NAO_REVISADO)
  dataCalculo      DateTime?
  observacao       String?
  natureza         NaturezaJuridicaClasse   @default(INDETERMINADO)
  instituicoes     Instituicao[]
  contatos         ContatoProfissional[]
  contaComercial   ContaComercial?
}

model TipoEstabelecimento {
  id           String        @id
  nome         String        @unique
  instituicoes Instituicao[]
}

model Instituicao {
  id                     String                  @id
  slug                   String                  @unique
  nome                   String
  descricao              String
  operacao24h            Boolean                 @default(false)
  porte                  String
  perfilCorporativo      Boolean                 @default(false)
  tipoDado               TipoDado                @default(DEMONSTRACAO)
  cnes                   String?                 @unique
  nomeOriginal           String?
  naturezaGestao         String?
  situacaoCadastral      String?
  coberturaDados         Int                     @default(100)
  coberturaJustificativa String?
  grupoEconomicoId       String?
  tipoEstabelecimentoId  String
  grupoEconomico         GrupoEconomico?         @relation(fields: [grupoEconomicoId], references: [id])
  tipoEstabelecimento    TipoEstabelecimento     @relation(fields: [tipoEstabelecimentoId], references: [id])
  unidades               Unidade[]
  servicos               ServicoSaude[]
  sinaisExpansao         SinalExpansao[]
  necessidades           NecessidadeMobilidade[]
  areasDecisoras         AreaDecisora[]
  evidencias             Evidencia[]
  indice                 IndicePrioridade?
  acoesComerciais        AcaoComercial[]
  segmentacao            SegmentacaoComercial?
  contatosProfissionais ContatoProfissional[]
  resolucoesCnpj        ResolucaoCNPJ[]
  sinaisContratacaoPublica SinalContratacaoPublica[]

  @@index([grupoEconomicoId])
  @@index([tipoEstabelecimentoId])
  @@index([operacao24h])
}

model Unidade {
  id            String        @id
  nome          String
  operacao24h   Boolean       @default(false)
  tipoDado      TipoDado      @default(DEMONSTRACAO)
  cnes          String?       @unique
  nomeOriginal  String?
  loteOrigemId  String?
  instituicaoId String
  instituicao   Instituicao   @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  endereco      Endereco?
  loteOrigem    LoteIngestao? @relation(fields: [loteOrigemId], references: [id])

  @@index([instituicaoId])
}

model Endereco {
  id         String   @id
  logradouro String
  numero     String
  bairro     String
  municipio  String
  uf         String
  tipoDado   TipoDado @default(DEMONSTRACAO)
  unidadeId  String   @unique
  unidade    Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([municipio, uf])
}

model ServicoSaude {
  id            String      @id
  nome          String
  descricao     String?
  tipoDado      TipoDado    @default(DEMONSTRACAO)
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
}

model SinalExpansao {
  id             String      @id
  titulo         String
  descricao      String
  dataReferencia DateTime?
  tipoDado       TipoDado    @default(DEMONSTRACAO)
  instituicaoId  String
  instituicao    Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  evidencias     Evidencia[]

  @@index([instituicaoId])
}

model NecessidadeMobilidade {
  id            String      @id
  titulo        String
  descricao     String
  tipoDado      TipoDado    @default(HIPOTESE)
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
}

model AreaDecisora {
  id            String      @id
  nome          String
  justificativa String
  tipoDado      TipoDado    @default(HIPOTESE)
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
}

model Fonte {
  id            String                @id
  nome          String
  url           String?
  identificador String?
  tipoDado      TipoDado
  evidencias    Evidencia[]
  lotes         LoteIngestao[]
  contatos      ContatoProfissional[]
  empresasReceita EmpresaReceita[]
  sinaisContratacao SinalContratacaoPublica[]
  operadorasANS OperadoraANS[]
  municipiosIBGE MunicipioIBGE[]
  indicadoresMTE IndicadorMTE[]
}

model ContatoProfissional {
  id                    String         @id
  nome                  String
  cargo                 String?
  area                  String?
  empresa               String
  linkedinUrl           String?
  paginaProfissionalUrl String?
  emailCorporativo      String?
  telefoneProfissional  String?
  ramal                 String?
  telefoneDepartamental String?
  senioridade           String?
  papelComercial        String?
  indiceQualidade       Int            @default(0)
  justificativaQualidade String?
  tipoPapelComercial    TipoDado       @default(INFERENCIA)
  tipoDado              TipoDado       @default(FATO_PUBLICO)
  confianca             NivelConfianca
  statusRevisao         StatusRevisao  @default(PENDENTE)
  ativo                 Boolean        @default(true)
  linkedinSimulado      Boolean        @default(false)
  fonteId               String
  dataEvidencia         DateTime
  observacao            String?
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt
  grupoEconomicoId      String?
  instituicaoId         String?
  escopoContato         EscopoContato  @default(ORGANIZACAO)
  grupoEconomico        GrupoEconomico? @relation(fields: [grupoEconomicoId], references: [id], onDelete: Cascade)
  instituicao           Instituicao?   @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  fonte                 Fonte          @relation(fields: [fonteId], references: [id])

  @@index([grupoEconomicoId, ativo])
  @@index([instituicaoId, ativo])
  @@index([statusRevisao])
  @@index([tipoDado, confianca])
}

model Evidencia {
  id             String             @id
  titulo         String
  descricao      String
  observacao     String?
  dataColeta     DateTime
  dataReferencia DateTime?
  tipo           TipoDado
  confianca      NivelConfianca
  statusRevisao  StatusRevisao
  instituicaoId  String
  fonteId        String
  loteId         String?
  origemCampo    String?
  instituicao    Instituicao        @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  fonte          Fonte              @relation(fields: [fonteId], references: [id])
  lote           LoteIngestao?      @relation(fields: [loteId], references: [id])
  sinaisExpansao SinalExpansao[]
  componentes    ComponenteIndice[]

  @@index([instituicaoId])
  @@index([statusRevisao])
  @@index([tipo, confianca])
}

model IndicePrioridade {
  id            String             @id
  total         Int
  faixa         FaixaPrioridade
  versao        String
  calculadoEm   DateTime
  instituicaoId String             @unique
  instituicao   Instituicao        @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  componentes   ComponenteIndice[]

  @@index([total])
  @@index([faixa])
}

model ComponenteIndice {
  id                 String           @id
  criterio           String
  rotulo             String
  peso               Int
  valorObtido        Int
  disponivel         Boolean          @default(true)
  justificativa      String
  indicePrioridadeId String
  indicePrioridade   IndicePrioridade @relation(fields: [indicePrioridadeId], references: [id], onDelete: Cascade)
  evidencias         Evidencia[]

  @@index([indicePrioridadeId])
}

model AcaoComercial {
  id            String      @id
  titulo        String
  descricao     String
  prioridade    Int
  concluida     Boolean     @default(false)
  tipoDado      TipoDado    @default(DEMONSTRACAO)
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId, concluida])
}

model LoteIngestao {
  id                   String              @id
  fonteId              String
  arquivoNome          String
  fonteUrl             String
  dataReferencia       DateTime?
  inicio               DateTime
  fim                  DateTime?
  status               StatusLote
  quantidadeLida       Int                 @default(0)
  quantidadeAceita     Int                 @default(0)
  quantidadeRejeitada  Int                 @default(0)
  quantidadeRevisao    Int                 @default(0)
  quantidadeAtualizada Int                 @default(0)
  quantidadePublicada  Int                 @default(0)
  errosJson            String?
  hashArquivo          String?
  versaoImportador     String
  fonte                Fonte               @relation(fields: [fonteId], references: [id])
  registrosBrutos      RegistroBrutoCNES[]
  evidencias           Evidencia[]
  unidades             Unidade[]
  empresasReceita      EmpresaReceita[]
  resolucoesCnpj       ResolucaoCNPJ[]
  sinaisContratacao    SinalContratacaoPublica[]
  operadorasANS        OperadoraANS[]

  @@index([fonteId, dataReferencia])
  @@index([status, inicio])
}

model RegistroBrutoCNES {
  id          String                 @id
  loteId      String
  linha       Int
  cnes        String?
  payloadJson String
  status      StatusRegistroIngestao
  errosJson   String?
  lote        LoteIngestao           @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@unique([loteId, linha])
  @@index([cnes])
  @@index([status])
}

model SegmentacaoComercial {
  id              String                   @id
  instituicaoId   String                   @unique
  segmento        SegmentoComercial
  indiceAderencia Int
  faixaAderencia  FaixaAderencia
  regraAplicada   String
  versaoRegra     String
  dataCalculo     DateTime
  nivelConfianca  NivelConfianca
  justificativa   String
  componentesJson String
  statusRevisao   StatusRevisaoSegmentacao @default(NAO_REVISADO)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @default(now())
  instituicao     Instituicao              @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([segmento])
  @@index([faixaAderencia])
}

enum ResultadoAbordagem {
  NAO_ABORDADA
  ABORDADA
  EM_ANALISE
  REUNIAO
  PROPOSTA
  CONTRATO
  DESCARTADA
  AGUARDANDO_DADOS
}

enum AcaoComercialRecomendada {
  ABORDAR_IMEDIATAMENTE
  PESQUISAR_MELHOR
  REVISAR_VINCULO
  BAIXA_PRIORIDADE
  AGUARDAR_ENRIQUECIMENTO
}

model ContaComercial {
  id                        String                   @id
  nome                      String
  tipoDado                  TipoDado                 @default(FATO_OFICIAL)
  grupoEconomicoId          String?                  @unique
  natureza                  NaturezaJuridicaClasse   @default(INDETERMINADO)
  naturezaPublicaOuPrivada  String                   @default("INDETERMINADO")
  quantidadeUnidades        Int                      @default(0)
  quantidadeHospitais       Int                      @default(0)
  quantidadeContatos        Int                      @default(0)
  cidades                   String                   @default("")
  cnpjPrincipal             String?
  situacaoCadastral         String?
  tipoVinculo               TipoVinculo              @default(ISOLADO)
  confiancaOrganizacional   NivelConfianca           @default(BAIXA)
  coberturaDados            Int                      @default(100)
  statusRevisao             StatusRevisaoSegmentacao @default(NAO_REVISADO)
  indicePrioridadeComercial Int                      @default(0)
  faixaPrioridadeComercial  FaixaPrioridade          @default(BAIXA)
  acaoRecomendada           AcaoComercialRecomendada @default(AGUARDAR_ENRIQUECIMENTO)
  justificativaAcao         String?
  componentesIndiceJson     String?
  resultadoAbordagem        ResultadoAbordagem       @default(NAO_ABORDADA)
  criadoEm                  DateTime                 @default(now())
  atualizadoEm              DateTime                 @updatedAt
  grupoEconomico            GrupoEconomico?          @relation(fields: [grupoEconomicoId], references: [id])
  historicoAbordagem        RegistroAbordagem[]

  @@index([tipoDado, faixaPrioridadeComercial])
  @@index([indicePrioridadeComercial])
  @@index([resultadoAbordagem])
}

model RegistroAbordagem {
  id                 String             @id
  contaComercialId   String
  data               DateTime           @default(now())
  resultado          ResultadoAbordagem
  usuarioResponsavel String?
  observacao         String
  proximaAcao        String?
  fonteOuEvidencia   String?
  tipoDado           TipoDado           @default(FATO_OFICIAL)
  criadoEm           DateTime           @default(now())
  contaComercial     ContaComercial     @relation(fields: [contaComercialId], references: [id], onDelete: Cascade)

  @@index([contaComercialId, data])
  @@index([resultado])
}

enum StatusPesquisaContato {
  COM_CONTATO_VERIFICAVEL
  SEM_CONTATO_VERIFICAVEL
  PESQUISA_PENDENTE
}

enum StatusFilaOrganizacao {
  PENDENTE
  EM_PROCESSAMENTO
  CONCLUIDA
  SEM_CONTATO
}

model PesquisaContatoOrganizacao {
  id                String                @id
  grupoEconomicoId  String                @unique
  status            StatusPesquisaContato
  dataPesquisa      DateTime
  termosConsulta    String
  fontesConsultadas String
  resultado         String
  confianca         NivelConfianca
  statusRevisao     StatusRevisao
  criadoEm          DateTime              @default(now())
  atualizadoEm      DateTime              @updatedAt
}

model FilaOrganizacao {
  grupoEconomicoId String                @id
  nome             String
  status           StatusFilaOrganizacao
  workerId         String?
  startedAt        DateTime?
  leaseUntil       DateTime?
  atualizadoEm     DateTime              @updatedAt
}

enum TipoResolucaoCNPJ {
  EXATO_CNPJ
  MESMO_CNPJ_BASICO
  MATRIZ_FILIAL
  NAO_RESOLVIDO
  CONFLITO
}

model EmpresaReceita {
  id                        String             @id
  cnpj                      String             @unique
  cnpjBasico                String
  cnpjOrdem                 String
  cnpjDv                    String
  identificadorMatrizFilial Int?               // 1 = MATRIZ, 2 = FILIAL
  razaoSocial               String
  nomeFantasia              String?
  situacaoCadastral         String?            // "01"=NULA, "02"=ATIVA, "03"=SUSPENSA, "04"=INAPTA, "08"=BAIXADA
  dataSituacaoCadastral     DateTime?
  motivoSituacaoCadastral   String?
  dataInicioAtividade       DateTime?
  cnaeFiscalPrincipal       String?
  cnaeFiscalSecundaria      String?
  naturezaJuridica          String?
  qualificacaoResponsavel   String?
  capitalSocial             Float?
  porteEmpresa              String?            // "00"=NAO INFORMADO, "01"=ME, "03"=EPP, "05"=DEMAIS
  enteFederativoResponsavel String?
  tipoLogradouro            String?
  logradouro                String?
  numero                    String?
  complemento               String?
  bairro                    String?
  cep                       String?
  uf                        String?
  municipio                 String?
  tipoDado                  TipoDado           @default(FATO_OFICIAL)
  fonteId                   String?
  loteId                    String?
  competencia               String?            // ex: "2024-05", "2026-08"
  dataReferencia            DateTime?
  hashRegistro              String?            // SHA-256 do registro original
  confianca                 NivelConfianca     @default(ALTA)
  statusRevisao             StatusRevisao      @default(APROVADA)
  criadoEm                  DateTime           @default(now())
  atualizadoEm              DateTime           @updatedAt

  fonte                     Fonte?             @relation(fields: [fonteId], references: [id])
  lote                      LoteIngestao?      @relation(fields: [loteId], references: [id])
  resolucoes                ResolucaoCNPJ[]

  @@index([cnpjBasico])
  @@index([situacaoCadastral])
  @@index([uf, municipio])
  @@index([tipoDado, confianca])
}

model ResolucaoCNPJ {
  id               String             @id
  instituicaoId    String
  cnes             String?
  cnpjCnes         String?
  cnpjBasicoCnes   String?
  empresaReceitaId String?
  tipoResolucao    TipoResolucaoCNPJ
  tipoDado         TipoDado           @default(FATO_OFICIAL)
  confianca        NivelConfianca     @default(ALTA)
  statusRevisao    StatusRevisao      @default(APROVADA)
  metodo           String
  justificativa    String?
  divergenciasJson String?
  loteId           String?
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt

  instituicao      Instituicao        @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  empresaReceita   EmpresaReceita?    @relation(fields: [empresaReceitaId], references: [id])
  lote             LoteIngestao?      @relation(fields: [loteId], references: [id])

  @@index([instituicaoId])
  @@index([empresaReceitaId])
  @@index([tipoResolucao])
  @@index([cnpjCnes])
  @@index([cnpjBasicoCnes])
}

model SinalContratacaoPublica {
  id               String         @id
  identificadorPNCP String        @unique
  objeto           String
  modalidade       String
  dataPublicacao   DateTime
  valorEstimado    Float?
  cnpjOrgao        String?
  razaoSocialOrgao String?
  municipio        String?
  uf               String?
  palavrasChave    String
  sinalMobilidade  Boolean        @default(false)
  categoriaPNCP    String         @default("SINAL_CONTRATACAO") // "SINAL_CONTRATACAO" ou "CONTRATO_CONFIRMADO"
  tipoContrato     String?
  fornecedorCNPJ   String?
  fornecedorNome   String?
  urlPublica      String?
  fonteId          String
  loteId           String?
  dataReferencia   DateTime?
  tipoDado         TipoDado       @default(FATO_PUBLICO)
  confianca        NivelConfianca @default(ALTA)
  statusRevisao    StatusRevisao  @default(APROVADA)
  hashRegistro     String
  instituicaoId    String?
  metodoVinculo    String?
  confiancaVinculo NivelConfianca?
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt

  fonte            Fonte          @relation(fields: [fonteId], references: [id])
  lote             LoteIngestao?  @relation(fields: [loteId], references: [id])
  instituicao      Instituicao?   @relation(fields: [instituicaoId], references: [id])

  @@index([identificadorPNCP])
  @@index([sinalMobilidade])
  @@index([categoriaPNCP])
  @@index([cnpjOrgao])
  @@index([uf, municipio])
  @@index([tipoDado, confianca])
  @@index([instituicaoId])
}

model EnriquecimentoCNPJTerceiro {
  id                  String         @id @default(cuid())
  cnpj                String         @unique
  provedor            String         // "BRASIL_API"
  razaoSocial         String?
  nomeFantasia        String?
  situacaoCadastral   String?
  dataSituacao        DateTime?
  dataInicioAtividade DateTime?
  cnaePrincipal       String?
  naturezaJuridica    String?
  porte               String?
  capitalSocial       Float?
  municipio           String?
  uf                  String?
  matrizFilial        String?        // "MATRIZ" ou "FILIAL"
  fonteUrl            String
  dataConsulta        DateTime       @default(now())
  dataReferencia      DateTime?
  hashResposta        String
  tipoDado            TipoDado       @default(DADO_TERCEIRO_NAO_CANONICO)
  confianca           NivelConfianca @default(MEDIA)
  statusRevisao       StatusRevisao  @default(PENDENTE)
  criadoEm            DateTime       @default(now())
  atualizadoEm        DateTime       @updatedAt

  @@index([cnpj])
  @@index([provedor])
  @@index([tipoDado, confianca])
  @@index([uf, municipio])
}

model OperadoraANS {
  id                    String         @id
  registroAns           String         @unique
  cnpj                  String
  razaoSocial           String
  nomeFantasia          String?
  modalidade            String
  situacao              String         @default("Ativa")
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  cidade                String
  uf                    String
  cep                   String?
  regiaoComercializacao Int?
  dataRegistroAns       DateTime?
  fonteId               String
  loteId                String?
  tipoDado              TipoDado       @default(FATO_OFICIAL)
  confianca             NivelConfianca @default(ALTA)
  statusRevisao         StatusRevisao  @default(APROVADA)
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt

  fonte                 Fonte          @relation(fields: [fonteId], references: [id])
  lote                  LoteIngestao?  @relation(fields: [loteId], references: [id])

  @@index([cnpj])
  @@index([registroAns])
  @@index([uf, cidade])
  @@index([modalidade])
}

model MunicipioIBGE {
  id                  String         @id
  codigoIbge6         String
  nome                String
  ufSigla             String
  ufNome              String
  regiaoNome          String
  microrregiao        String?
  mesorregiao         String?
  regiaoImediata      String?
  regiaoIntermediaria String?
  populacao           Int?
  fonteId             String
  tipoDado            TipoDado       @default(FATO_OFICIAL)
  confianca           NivelConfianca @default(ALTA)
  criadoEm            DateTime       @default(now())
  atualizadoEm        DateTime       @updatedAt

  fonte               Fonte          @relation(fields: [fonteId], references: [id])

  @@index([codigoIbge6])
  @@index([ufSigla])
  @@index([nome])
}

model IndicadorMTE {
  id                    String         @id @default(cuid())
  municipio             String
  uf                    String
  codigoIbge6           String?
  setorCnae             String
  descricaoSetor        String
  periodo               String
  indicador             String
  quantidadeAgregada    String
  detalhesAgregadosJson String?
  fonteId               String
  tipoDado              TipoDado       @default(FATO_PUBLICO)
  confianca             NivelConfianca @default(ALTA)
  statusRevisao         StatusRevisao  @default(APROVADA)
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt

  fonte                 Fonte          @relation(fields: [fonteId], references: [id])

  @@index([uf, municipio])
  @@index([setorCnae])
  @@index([codigoIbge6])
}
